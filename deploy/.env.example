# Copia in deploy/.env (permessi 600) e sostituisci i valori. Non va nel repository.
# Segreti casuali: openssl rand -hex 48

# Dominio dell'app. Gratis: <nome>.duckdns.org (ogni locale sarà <locale>.<nome>.duckdns.org)
APP_DOMAIN=nome.duckdns.org
ACME_EMAIL=tua@email.it
DNS_PROVIDER=duckdns
DUCKDNS_TOKEN=token-di-duckdns

# Immagine da avviare (pubblicata dal workflow Rilascio)
APP_IMAGE=ghcr.io/luke4915/stand-manager:latest

# Database: password dell'utente privilegiato (migrazioni e backup) e dei due ruoli dell'app
POSTGRES_PASSWORD=cambiami
PG_PASSWORD=cambiami-app
PG_MASTER_PASSWORD=cambiami-master

JWT_SECRET=cambiami
MASTER_JWT_SECRET=cambiami-diverso
# Hash bcrypt della password del master: vedi docs/deployment.md
# ATTENZIONE: nel file .env di docker compose ogni $ dell'hash va raddoppiato ($$)
MASTER_PASSWORD_HASH=$$2b$$12$$sostituisci

WHATSAPP_DRIVER=off
LEGAL_NAME=Nome del fornitore
LEGAL_EMAIL=privacy@esempio.it
LEGAL_ADDRESS=
LEGAL_VAT=
