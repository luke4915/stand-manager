# Database
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=sagramanager
PG_PASSWORD=yourpassword
PG_PORT=5432
# Solo per `npm run migrate`: utente privilegiato per le DDL. L'app non la usa mai.
MIGRATION_DATABASE_URL=postgres://migration_user:yourpassword@localhost:5432/sagramanager

# Auth
JWT_SECRET=change-this-to-a-random-32-char-string

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Frontend (CORS)
CORS_ORIGIN=http://localhost:5173